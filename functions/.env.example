# Firebase Functions Environment Variables
# Copy this file to .env for local emulator use, or use Secret Manager for production.
# DO NOT commit secrets to git.

# -----------------------------------------------------------------------------
# Paystack (payment processing)
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=sk_live_your_paystack_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
PAYSTACK_CALLBACK_URL=https://nimex.ng/payment-success

# -----------------------------------------------------------------------------
# Flutterwave (payment processing)
# -----------------------------------------------------------------------------
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-your_secret_key-X
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-your_public_key-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TEST-your_encryption_key-X
FLUTTERWAVE_WEBHOOK_SECRET=your_flutterwave_webhook_secret

# -----------------------------------------------------------------------------
# Terminal Africa (delivery / shipping)
# -----------------------------------------------------------------------------
TERMINAL_SECRET_KEY=terminal_secret_key
TERMINAL_WEBHOOK_SECRET=terminal_webhook_secret
TERMINAL_BASE_URL=https://api.terminal.africa/v1

# -----------------------------------------------------------------------------
# Termii (SMS OTP)
# -----------------------------------------------------------------------------
TERMII_API_KEY=termii_api_key
TERMII_SENDER_ID=NIMEX

# -----------------------------------------------------------------------------
# Google Maps (geocoding / distance matrix)
# -----------------------------------------------------------------------------
# Server-side key used by the Cloud Functions proxy. Restrict this key to the
# Functions service account / server IP in the Google Cloud Console. The web
# app no longer exposes a Google Maps key in the bundle.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# -----------------------------------------------------------------------------
# Sentry / Error Tracking
# -----------------------------------------------------------------------------
SENTRY_DSN=https://public_key@o0.ingest.sentry.io/project_id
SENTRY_ENVIRONMENT=production

# -----------------------------------------------------------------------------
# Resend / Email
# -----------------------------------------------------------------------------
RESEND_API_KEY=resend_api_key
EMAIL_FROM=noreply@nimex.ng

# -----------------------------------------------------------------------------
# Sentry / Error tracking
# -----------------------------------------------------------------------------
SENTRY_DSN=your_sentry_dsn

# -----------------------------------------------------------------------------
# Firebase / App Check
# -----------------------------------------------------------------------------
# FIREBASE_APPCHECK_DEBUG_TOKEN=...

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# For production, store all *_SECRET_KEY and API keys in Google Cloud Secret
# Manager and reference them via firebase functions:secrets:set.
# Never commit real values to version control.
