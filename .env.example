# Web app environment variables (Vite)
# Copy this file to .env and fill in real values.

# Firebase (public client config)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=nimex-ecommerce.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nimex-ecommerce
VITE_FIREBASE_STORAGE_BUCKET=nimex-ecommerce.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloud Functions
VITE_API_URL=https://us-central1-nimex-ecommerce.cloudfunctions.net

# Payment provider public key (safe to ship in client bundle)
VITE_PAYSTACK_PUBLIC_KEY=pk_live_your_paystack_public_key
VITE_PAYSTACK_TEST_MODE=false

# App URL for payment callbacks
VITE_APP_URL=https://nimex.ng
